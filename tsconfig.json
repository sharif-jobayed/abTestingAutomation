{
    "compilerOptions": {
        "target": "es2022",
        "moduleResolution": "node",
        "module": "esnext",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "types": [
            "node",
            "@wdio/globals/types",
            "@wdio/mocha-framework"
        ],
        "resolveJsonModule": true,
        // "isolatedModules": true,
        "noEmit": true,
        "allowImportingTsExtensions": true
    }
}
